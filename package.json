{
  "name": "mungtange",
  "version": "0.1.0",
  "description": "Prompt-first identity-grounded UI design skill with optional source-backed visual tooling",
  "type": "module",
  "files": [
    "skills",
    "SKILLS.md",
    "README.md",
    "docs",
    "catalog",
    "site",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "check": "node --check scripts/brand-competition.mjs && node --check scripts/visual-capture.mjs && node --check scripts/visual-critic.mjs && node --check scripts/visual-smoke.mjs && npm test",
    "build:site": "node scripts/build-site.mjs",
    "lint:catalog": "node scripts/verify-catalog.mjs",
    "verify": "npm run check:skill && npm run check:source-audit && npm run knowledge:verify && npm run check && npm run build:site && npm run lint:catalog",
    "sync:skill": "node scripts/sync-skill.mjs",
    "check:skill": "node scripts/sync-skill.mjs --check",
    "analyze:sources": "npm run audit:sources",
    "check:synthesis": "npm run check:source-audit",
    "audit:sources": "node scripts/audit-upstream-sources.mjs",
    "check:source-audit": "node scripts/verify-source-audit.mjs",
    "knowledge:build": "node scripts/build-knowledge.mjs",
    "knowledge:verify": "node scripts/check-knowledge.mjs",
    "knowledge:curate": "node scripts/curate-knowledge.mjs",
    "knowledge:index": "node scripts/compile-knowledge-index.mjs",
    "visual:smoke": "node scripts/visual-smoke.mjs",
    "visual:contract": "node --test tests/visual-direction.test.mjs",
    "brand:validate": "node scripts/brand-competition.mjs validate --file examples/brand-competition-pynext.json",
    "visual:critic": "node scripts/visual-critic.mjs",
    "motion:smoke": "node scripts/motion-smoke.mjs",
    "motion:capture": "node scripts/motion-capture.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "keywords": [
    "agent-skills",
    "skill-md",
    "design",
    "web",
    "npx",
    "harness",
    "pipeline"
  ]
}
