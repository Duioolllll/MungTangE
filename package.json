{
  "name": "mungtange",
  "version": "0.1.0",
  "description": "Prompt-first web UI design skill; optional 10-source expert guide and separate research archive",
  "type": "module",
  "bin": {
    "mungtange": "./bin/mungtange.js"
  },
  "exports": {
    ".": "./src/catalog.js"
  },
  "files": [
    "bin",
    "src",
    "catalog",
    "skills",
    "SKILLS.md",
    "README.md",
    "docs",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "check": "node --check bin/mungtange.js && node --check src/catalog.js && node --check src/project.js && node --check src/pipeline.js && node --check src/install.js && npm test",
    "smoke": "node bin/mungtange.js doctor && node bin/mungtange.js catalog --category web --limit 3",
    "build:site": "node scripts/build-site.mjs",
    "lint:catalog": "node scripts/verify-catalog.mjs",
    "verify": "npm run check:skill && npm run check:source-audit && npm run check && npm run build:site && npm run lint:catalog",
    "sync:skill": "node scripts/sync-skill.mjs",
    "check:skill": "node scripts/sync-skill.mjs --check",
    "analyze:sources": "npm run audit:sources",
    "check:synthesis": "npm run check:source-audit",
    "audit:sources": "node scripts/audit-upstream-sources.mjs",
    "check:source-audit": "node scripts/verify-source-audit.mjs",
    "eval:prepare": "node evals/cli.mjs prepare",
    "eval:run": "node evals/cli.mjs run",
    "eval:score": "node evals/cli.mjs score",
    "eval:smoke": "node evals/smoke.mjs",
    "eval:contract": "node --test tests/evals-contract.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "keywords": [
    "agent-skills",
    "skill-md",
    "design",
    "web",
    "npx",
    "harness",
    "pipeline"
  ],
  "devDependencies": {
    "axe-core": "4.14.0",
    "pixelmatch": "8.0.0",
    "playwright": "1.65.0",
    "pngjs": "7.0.0"
  }
}
